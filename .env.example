# iRacing Setup Advisor — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── App ───────────────────────────────────────────────────────────────────
APP_NAME="iRacing Setup Advisor"
DEBUG=false
ENVIRONMENT=production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
FRONTEND_URL=https://yourapp.com
ALLOWED_ORIGINS=["https://yourapp.com","https://www.yourapp.com"]

# ── Database ──────────────────────────────────────────────────────────────
# Local dev (docker-compose): postgresql+asyncpg://iracing:iracing_dev@localhost:5432/iracing_advisor
# Production (Supabase / Railway / Neon):
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ── Redis ─────────────────────────────────────────────────────────────────
# Local dev (docker-compose): redis://localhost:6379
# Production (Upstash / Redis Cloud):
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Stripe ────────────────────────────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
# Get from https://dashboard.stripe.com/webhooks — add endpoint /billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs — create products/prices in Stripe dashboard
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_TEAM_MONTHLY=price_...
STRIPE_PRICE_TEAM_ANNUAL=price_...

# ── Claude / Anthropic ────────────────────────────────────────────────────
# Get from https://console.anthropic.com/
# This key is server-side ONLY — never exposed to clients
ANTHROPIC_API_KEY=sk-ant-...

# ── Object Storage (Cloudflare R2 recommended — no egress fees) ───────────
# For R2: endpoint = https://<account-id>.r2.cloudflarestorage.com
# For AWS S3: leave STORAGE_ENDPOINT_URL blank
STORAGE_BUCKET=iracing-advisor
STORAGE_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=your-r2-access-key-id
AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
STORAGE_REGION=auto
# Delete raw IBT files after N days (saves storage costs)
IBT_EXPIRY_DAYS=90

# ── Email ─────────────────────────────────────────────────────────────────
# Option A: SMTP
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=re_...
EMAIL_FROM=noreply@yourapp.com
# Option B: Resend API (simpler)
RESEND_API_KEY=re_...

# ── Discord OAuth (optional) ──────────────────────────────────────────────
# Create app at https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Tier limits (override defaults if needed) ─────────────────────────────
FREE_SESSIONS_PER_MONTH=10
FREE_AI_CALLS_PER_DAY=5
FREE_STORAGE_MB=512
PRO_AI_CALLS_PER_DAY=200
PRO_STORAGE_MB=51200
TEAM_AI_CALLS_PER_DAY=500
TEAM_STORAGE_MB=204800
